---
import { site, nav } from "../data/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="header">
  <div class="wrap bar">
    <a class="brand" href="/" transition:name="brand">{site.name}</a>
    <nav aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={pathname === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
    background: var(--bg-header);
    backdrop-filter: blur(16px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }

  .brand {
    color: var(--ink);
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 0.25rem;
  }

  nav a {
    padding: 0.4rem 0.8rem;
    color: var(--muted);
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: 999px;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
    background: rgb(255 255 255 / 0.05);
  }

  nav a[aria-current="page"] {
    color: var(--accent);
  }

  @media (max-width: 420px) {
    .brand {
      font-size: 0.95rem;
    }

    nav a {
      padding: 0.35rem 0.55rem;
    }
  }
</style>
