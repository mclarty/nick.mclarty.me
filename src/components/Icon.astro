---
interface Props {
  name: "shield" | "wing" | "star" | "x" | "github" | "key" | "file" | "mail";
  size?: number;
}

const { name, size = 28 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "shield" && (
      <>
        <path d="M12 3 5 6.2v5.3c0 4 3 7.3 7 8.5 4-1.2 7-4.5 7-8.5V6.2L12 3Z" />
        <path d="M9.2 12.2 11 14l3.8-4" />
      </>
    )
  }
  {
    name === "wing" && (
      <>
        <path d="M3 13.5h10l8-3.5" />
        <path d="M13 13.5 7 8.5H5.5L9 13.5" />
        <path d="M13 13.5 8 19h1.6L15 13.5" />
        <path d="M13 13.5h8v-1.2" />
      </>
    )
  }
  {
    name === "star" && (
      <path d="m12 3 2.4 6.6H21l-5.2 4 2 6.4L12 16.6 6.2 20l2-6.4L3 9.6h6.6L12 3Z" />
    )
  }
  {
    name === "x" && (
      <path d="M5 5 19 19M19 5 5 19" stroke-width="2" />
    )
  }
  {
    name === "github" && (
      <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.9a3.4 3.4 0 0 0-1-2.6c3.2-.4 6.5-1.6 6.5-7A5.4 5.4 0 0 0 19 4.8 5 5 0 0 0 19 1s-1.3-.4-4 1.5A13.4 13.4 0 0 0 5 1 5 5 0 0 0 5 4.8 5.4 5.4 0 0 0 3.5 9.5c0 5.4 3.3 6.6 6.5 7a3.4 3.4 0 0 0-1 2.6V21" />
    )
  }
  {
    name === "key" && (
      <>
        <circle cx="8" cy="15" r="4" />
        <path d="M11.7 12.3 20 4v3h3" />
        <path d="M16 8h3" />
      </>
    )
  }
  {
    name === "file" && (
      <>
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" />
        <path d="M14 3v5h5M9 13h6M9 17h4" />
      </>
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
</svg>
