---
import { site } from "../data/site";
---

<footer>
  <div class="wrap">
    <p>
      &copy; {site.name} &bull; Built with
      <a href="https://astro.build" rel="noreferrer">Astro</a>
    </p>
    <p class="links">
      <a href={site.links.x} target="_blank" rel="noreferrer">𝕏</a>
      <a href={site.links.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={site.links.resume}>Resume</a>
      <a href={site.links.pgp}>PGP</a>
    </p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 2.5rem 0;
    color: var(--faint);
    text-align: center;
  }

  p {
    margin: 0;
  }

  .links {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 0.75rem;
    font-size: 0.92rem;
  }

  a {
    color: var(--muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }
</style>
