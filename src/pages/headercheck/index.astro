---
import Base from "../../layouts/Base.astro";
---

<Base
  title="HeaderCheck"
  description="Privacy-first on-device SPF, DKIM, and DMARC analysis for iPhone and iPad."
>
  <section class="mast">
    <div class="wrap narrow">
      <p class="kicker">HeaderCheck</p>
      <h1>Auth verdicts. On your device.</h1>
      <p class="lede">
        HeaderCheck turns raw email authentication headers into plain-language
        SPF, DKIM, and DMARC verdicts — entirely on your iPhone or iPad. No
        account. No upload.
      </p>
      <ul class="links">
        <li>
          <a href="/headercheck/privacy">
            <strong>Privacy Policy</strong>
            <em>What stays on your device</em>
          </a>
        </li>
        <li>
          <a href="/headercheck/support">
            <strong>Support</strong>
            <em>Help and contact</em>
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .mast {
    padding: 4.5rem 0 5rem;
  }

  .narrow {
    max-width: 42rem;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
  }

  .lede {
    margin: 0 0 2rem;
    max-width: 36rem;
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1.65;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .links a {
    display: block;
    padding: 1.25rem 1.3rem;
    color: inherit;
    text-decoration: none;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    transition: border-color 200ms ease;
  }

  .links a:hover {
    border-color: rgb(0 212 255 / 0.45);
  }

  .links strong,
  .links em {
    display: block;
  }

  .links strong {
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .links em {
    margin-top: 0.2rem;
    color: var(--faint);
    font-style: normal;
    font-size: 0.9rem;
  }
</style>
