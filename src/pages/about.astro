---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Portrait from "../components/Portrait.astro";
import Timeline from "../components/Timeline.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";

const timeline = (await getCollection("timeline")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="About" description={site.description}>
  <section class="mast">
    <div class="wrap split">
      <Portrait size={148} />
      <div>
        <p class="kicker">About</p>
        <h1>Cyber executive. Pilot. Veteran.</h1>
        <p class="lede">
          Native Texan. Adopted Floridian. I live in {site.location} — sunshine,
          aviation, and staying informed.
        </p>
        <div class="prose">
          <p>
            I work in cybersecurity, helping protect systems and data in an
            increasingly digital world. The through-line is practical security:
            reduce real risk without getting in the way of the work.
          </p>
          <p>
            I'm a certified pilot with a deep passion for flying. Nothing beats
            being up in the air.
          </p>
          <p>
            I'm a proud veteran of the United States Armed Forces. Service shaped
            my discipline and leadership.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap narrow">
      <p class="kicker">Education &amp; Experience</p>
      <h2>A short timeline</h2>
      <Timeline entries={timeline} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="kicker">Files</p>
      <h2>Resume, thesis, and key</h2>
      <ul class="files">
        <li>
          <a href={site.links.resume}>
            <Icon name="file" />
            <span>
              <strong>Resume</strong>
              <em>Curriculum vitae, PDF</em>
            </span>
          </a>
        </li>
        <li>
          <a href={site.links.thesis}>
            <Icon name="file" />
            <span>
              <strong>Master's thesis</strong>
              <em>M.Sc. Cybersecurity Studies, PDF</em>
            </span>
          </a>
        </li>
        <li>
          <a href={site.links.pgp}>
            <Icon name="key" />
            <span>
              <strong>PGP public key</strong>
              <em>nick@mclarty.me</em>
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .mast {
    padding: 4.5rem 0 4rem;
  }

  .split {
    display: flex;
    align-items: flex-start;
    gap: 2.25rem;
  }

  .split :global(.portrait) {
    flex: none;
    margin-top: 0.35rem;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
  }

  .lede {
    margin: 0;
    max-width: 36rem;
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1.65;
  }

  .section {
    padding: 3.5rem 0 5rem;
  }

  .alt {
    background: var(--bg-card);
  }

  .narrow {
    max-width: 42rem;
    margin-inline: auto;
  }

  h2 {
    margin: 0 0 2rem;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }

  .prose {
    margin-top: 1.75rem;
    font-size: 1.12rem;
    line-height: 1.75;
    color: #d1d5db;
  }

  .prose p {
    margin: 0 0 1.2rem;
  }

  .files {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, 1fr);
  }

  .files a {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    min-height: 100%;
    padding: 1.25rem 1.3rem;
    color: inherit;
    text-decoration: none;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    transition: border-color 200ms ease;
  }

  .files a:hover {
    border-color: rgb(0 212 255 / 0.45);
  }

  .files :global(.icon) {
    flex: none;
    color: var(--accent);
    margin-top: 0.15rem;
  }

  .files strong,
  .files em {
    display: block;
  }

  .files strong {
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .files em {
    margin-top: 0.2rem;
    color: var(--faint);
    font-style: normal;
    font-size: 0.9rem;
  }

  @media (max-width: 800px) {
    .split {
      flex-direction: column;
      align-items: flex-start;
    }

    .files {
      grid-template-columns: 1fr;
    }
  }
</style>
